    "epochs":        40,
    "patience":      12,
    "max_seq_len":   336,
    "seed":          42,
    "optimizer":     "AdamW",
    "grad_clip":     1.0,
    "scheduler_factor":  0.5,
    "scheduler_patience": 3,
    "graph": "experiments/gat/graphs/graph_F",
    "_architecture": "ICU EHR → [GRU-D | Medical KG+GAT] → [h_GRU | h_GAT] → Attention-Gated Fusion → Prediction MLP → Sepsis Risk",
    "_notes": "Phase 3 fusion. gat_out must equal grud_hidden (both=128) for cross-attention to work."
