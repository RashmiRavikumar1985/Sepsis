{
    "grud_hidden":   128,
    "gat_hidden":    64,
    "gat_out":       128,
    "gat_heads":     4,
    "fusion_heads":  4,
    "mlp_hidden1":   128,
    "mlp_hidden2":   64,
    "dropout":       0.2,
    "static_inject": true,
    "grud_attn": {
        "enabled":            true,
